generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  REVIEWER
  VIEWER
}

enum CoiStatus {
  COMPLIANT
  NON_COMPLIANT
  EXPIRING_SOON
  EXPIRED
  PENDING
  NO_COI
}

enum CoiReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum NotificationType {
  EXPIRATION_REMINDER
  UPLOAD_REQUEST
  REVIEW_COMPLETE
  COI_REJECTED
  WEEKLY_SUMMARY
}

enum NotificationStatus {
  SENT
  FAILED
}

enum Plan {
  FREE
  STARTER
  UNLIMITED
}

enum CoverageType {
  GENERAL_LIABILITY
  WORKERS_COMP
  UMBRELLA
  AUTO
  OTHER
}

enum CoiRequestStatus {
  REQUESTED
  FULFILLED
  CANCELLED
}

model Organization {
  id                    String   @id @default(uuid())
  name                  String
  email                 String
  phone                 String?
  address               String?
  plan                  Plan     @default(FREE)
  additionalInsuredNote String?
  slug                  String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  settings      OrganizationSettings?
  users         User[]
  vendors       Vendor[]
  cois          Coi[]
  notifications NotificationLog[]
  auditLogs     AuditLog[]
  apiClients    ApiClient[]
  coiRequests   CoiRequest[]
}

model OrganizationSettings {
  id    String @id @default(uuid())
  orgId String @unique

  minGeneralLiability Int @default(100000000)
  minWorkersComp      Int @default(50000000)
  minUmbrella         Int @default(100000000)
  minAutomobile       Int @default(100000000)

  reminderDaysBefore  Json    @default("[30, 14, 7, 0]")
  notifyOnUpload      Boolean @default(true)
  notifyOnExpiration  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  firstName    String
  lastName     String
  role             UserRole @default(ADMIN)
  emailVerified    Boolean  @default(false)
  emailVerifyToken String?  @unique
  inviteToken      String?  @unique
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedCois Coi[]        @relation("ReviewedBy")

  @@index([orgId])
}

model Vendor {
  id                  String    @id @default(uuid())
  orgId               String
  name                String
  contactName         String?
  email               String
  phone               String?
  address             String?
  trade               String?
  additionalEmails    String[]  @default([])
  notes               String?
  w9Path              String?
  masterAgreementPath String?
  uploadToken         String    @unique @default(uuid())
  coiStatus           CoiStatus @default(NO_COI)
  coreId              String?   @unique
  airtableRecordId    String?   @unique
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cois          Coi[]
  notifications NotificationLog[]
  coiRequests   CoiRequest[]

  @@index([orgId, deletedAt])
}

model Coi {
  id           String        @id @default(uuid())
  vendorId     String
  orgId        String
  coverageType CoverageType?

  // General Liability
  glPolicyNumber   String?
  glCoverageAmount Int?
  glExpirationDate DateTime?

  // Workers Compensation
  wcPolicyNumber   String?
  wcCoverageAmount Int?
  wcExpirationDate DateTime?

  // Umbrella
  umbPolicyNumber   String?
  umbCoverageAmount Int?
  umbExpirationDate DateTime?

  // Automobile
  autoPolicyNumber   String?
  autoCoverageAmount Int?
  autoExpirationDate DateTime?

  // Insurance Agent
  agentName        String?
  agentEmail       String?
  agentPhone       String?
  insuranceCompany String?

  // Certificate Holder
  certificateHolderName    String?
  certificateHolderAddress String?

  // Meta
  pdfPath         String
  status          CoiReviewStatus @default(PENDING_REVIEW)
  aiExtractedData Json?
  complianceFlags Json?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  airtableRecordId String?       @unique
  submittedAt     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])
  notifications NotificationLog[]

  @@index([orgId, status])
  @@index([vendorId, status])
  @@index([orgId, submittedAt])
}

model NotificationLog {
  id             String             @id @default(uuid())
  orgId          String
  vendorId       String?
  coiId          String?
  type           NotificationType
  recipientEmail String
  sentAt         DateTime           @default(now())
  status         NotificationStatus

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  coi          Coi?         @relation(fields: [coiId], references: [id])

  @@index([orgId])
  @@index([vendorId, type, sentAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, entity, action])
}

// A service-to-service API consumer (e.g. Quill, Core, or a future integration).
// The raw bearer token is never stored — only its SHA-256 hash. Scope an
// individual token to one org (orgId) or grant it platform access to every org
// (allOrgs) for a multi-tenant consumer.
model ApiClient {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]  @default([])
  orgId       String?
  allOrgs     Boolean   @default(false)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  coiRequests  CoiRequest[]

  @@index([orgId])
}

// The canonical record of a COI request for a vendor. Created by both the app UI
// and the public API so "is a request open?" has a single source of truth.
// Auto-resolved to FULFILLED when the vendor next becomes compliant.
model CoiRequest {
  id               String           @id @default(uuid())
  orgId            String
  vendorId         String
  status           CoiRequestStatus @default(REQUESTED)
  coverageTypes    String[]         @default([])
  note             String?
  requestedByEmail String?
  source           String           @default("app")
  apiClientId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  fulfilledAt      DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  apiClient    ApiClient?   @relation(fields: [apiClientId], references: [id], onDelete: SetNull)

  @@index([vendorId, status])
  @@index([orgId, createdAt])
}
