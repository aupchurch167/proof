DATABASE_URL=postgresql://user:pass@localhost:5432/proof
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
# Google Sign-In. OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Add your app origins to "Authorized JavaScript origins". Leave blank to disable Google sign-in.
# The client needs the SAME value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Required for AI COI data extraction. If unset/invalid, uploads still succeed
# but return an extractionError and the reviewer enters data manually.
ANTHROPIC_API_KEY=your-anthropic-key
# Optional override for the extraction model (defaults to claude-sonnet-4-20250514).
ANTHROPIC_MODEL=
# Resend API key (https://resend.com/api-keys). Must be paired with a verified
# FROM_EMAIL on a domain whose DKIM + SPF + DMARC are configured in Resend.
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
# Optional. If set, every outbound email gets a Reply-To header pointing here.
# This is the on-domain address Resend's inbound rules forward to a real inbox
# AND POST to /api/webhooks/resend-inbound. Leave blank to use FROM_EMAIL.
REPLY_TO_EMAIL=
# Optional. Signing secret from Resend's webhook config. If set, the inbound
# webhook rejects requests with an invalid Svix signature. Leave blank in dev.
RESEND_WEBHOOK_SECRET=
APP_URL=http://localhost:5173
PORT=4000
# Extra browser origins allowed to call the API (comma-separated). The Railway
# frontend + app.proofcoi.com + localhost are already allowed by default.
CORS_ORIGINS=
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=proof-coi-uploads
DO_SPACES_REGION=nyc3

# Public API (/api/v1) for service-to-service integrations (Quill, etc.).
# Tokens are NOT configured here — they live in the ApiClient table. Mint one
# with: node scripts/create-api-client.js --name "Quill" --org <slug>
# In non-production, callers may use the x-helm-test-org-slug dev-bypass header
# instead of a token. See docs/api-v1.md.
# Outbound webhooks (coi.updated) are per-endpoint rows too — register one with:
# node scripts/create-webhook-endpoint.js --name "Quill" --url <url> --all-orgs
# The generated whsec_ secret signs deliveries (X-Proof-Signature); no env var.

# Helm Core integration (vendor sync). Dev-bypass auth — no real auth yet.
HELM_CORE_INTEGRATION=true
CORE_API_URL=https://helmcore.up.railway.app
CORE_ORG_SLUG=mac
# Get this from Core's DB (users table). Leave blank locally to skip mirroring.
CORE_DEV_USER_ID=

# Airtable -> Proof one-time import (scripts/import-airtable-vendors.js).
# PAT from https://airtable.com/create/tokens with data.records:read + schema.bases:read.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
# Target Proof Organization uuid to import the vendors into.
PROOF_ORG_ID=
