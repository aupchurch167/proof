# Public origin of the Proof backend API (no trailing slash). Set this on the
# Railway Frontend service so the built client calls the backend cross-origin.
# Leave blank for local dev — Vite proxies /api to localhost:4000.
VITE_API_BASE_URL=

# Google Sign-In OAuth 2.0 Web client ID (same value as the backend's
# GOOGLE_CLIENT_ID). Leave blank to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
